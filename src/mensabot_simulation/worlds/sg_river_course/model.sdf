<?xml version="1.0"?>
<sdf version="1.11">
  <model name="sg_river_course">
    <static>true</static>

    <!-- Singapore River terrain -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/bumblebeeAS/models/Singapore River</uri>
      <pose>195.866 173.723 0.0 0 0 0</pose>
    </include>

    <!-- Sea surface -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water</uri>
    </include>

    <!-- Platform collision plane at world origin (for drone landing) -->
    <link name="platform_plane">
      <pose>0 0 0.0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>20 20 5</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Jetty collision (single box matching full jetty length) -->
    <link name="jetty_collision">
      <pose>93.469 -75.074 -0.5 0 0 -0.5457</pose>
      <collision name="collision">
        <geometry>
          <box><size>158.633 6.5 3</size></box>
        </geometry>
      </collision>
    </link>

    <!-- Visual piers (8 stacked along jetty line) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_0</name>
      <pose>93.469 -75.074 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_1</name>
      <pose>110.589 -85.394 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_2</name>
      <pose>127.709 -95.714 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_3</name>
      <pose>144.829 -106.034 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_4</name>
      <pose>161.949 -116.354 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_5</name>
      <pose>76.349 -64.754 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_6</name>
      <pose>59.229 -54.434 -5 0 0 1.0251</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pier</uri>
      <name>pier_7</name>
      <pose>42.109 -44.114 -5 0 0 1.0251</pose>
    </include>

    <!-- 200m x 200m boundary walls (invisible, collision only) -->
    <link name="wall_north">
      <pose>0 100 5 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>200 0.5 10</size></box>
        </geometry>
      </collision>
    </link>
    <link name="wall_south">
      <pose>0 -100 5 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>200 0.5 10</size></box>
        </geometry>
      </collision>
    </link>
    <link name="wall_east">
      <pose>100 0 5 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>0.5 200 10</size></box>
        </geometry>
      </collision>
    </link>
    <link name="wall_west">
      <pose>-100 0 5 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>0.5 200 10</size></box>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
