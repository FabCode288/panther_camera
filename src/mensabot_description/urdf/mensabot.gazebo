<?xml version="1.0"?>
<robot>
  <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find mensabot_bringup)/config/controller.yaml</parameters> 
      </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
  <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>

  <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
  </joint>

  <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
  </joint>
  </ros2_control>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <enable_metrics>true</enable_metrics>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ========================================================= -->
    <!-- RGB-D CAMERA SENSOR -->
    <!-- ========================================================= -->

    <!--
      Gazebo Sim RGB-D sensor.
      Gazebo uses +X as the rendering-sensor forward direction.
      camera_link is therefore mounted with +X pointing forward.

      The ROS optical frame is provided by camera_optical_frame in the Xacro.
      The ROS-Gazebo bridge below overrides the ROS message frame_id accordingly.
    -->
  <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera/rgbd</topic>
          <enable_metrics>true</enable_metrics>
          <camera>
              <!-- Approximation of the D435 horizontal color FOV. -->
              <horizontal_fov>1.21</horizontal_fov>

              <image>
                  <width>320</width>
                  <height>240</height>
                  <format>R8G8B8</format>
              </image>

              <clip>
                  <near>0.10</near>
                  <far>10.0</far>
              </clip>
          </camera>
      </sensor>
  </gazebo>
  
</robot>
